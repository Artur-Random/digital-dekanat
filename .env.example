# Скопируйте в .env и заполните. .env не коммитится.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@127.0.0.1:5432/ИМЯ_БАЗЫ?schema=public
DATABASE_URL=

# Для docker-compose.yml (локальная база).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Адрес для Playwright и скриншотов. По умолчанию http://localhost:3000.
BASE_URL=

# Пароли демо-аккаунтов для npm run demo:reset. Без них сброс падает.
# Боевые значения задаются секретами GitHub при деплое.
DEMO_PASSWORD_ALINA=
DEMO_PASSWORD_DENIS=
DEMO_PASSWORD_MFC=
DEMO_PASSWORD_DEKANAT=

# Только на сервере (/opt/dekanat/.env создаёт deploy/bootstrap.sh): домен для Caddy.
SITE_DOMAIN=
