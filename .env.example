# Скопируйте в .env и заполните. .env не коммитится.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@127.0.0.1:5432/ИМЯ_БАЗЫ?schema=public
DATABASE_URL=

# Для docker-compose.yml (локальная база).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Адрес для Playwright и скриншотов. По умолчанию http://localhost:3000.
BASE_URL=
